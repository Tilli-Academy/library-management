# Production web server: serves the built app and forwards /api/ to the backend container.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Don't advertise the nginx version.
    server_tokens off;
    # Matches the backend's request size limit.
    client_max_body_size 64k;

    # Real client IP for rate limiting. Users normally reach this server through a front proxy or TLS
    # terminator; only THAT proxy (PAGETURN_TRUSTED_PROXY_CIDR) may tell us the client's IP. Anyone else's
    # X-Forwarded-For header is ignored. The default (127.0.0.1/32) trusts no one, because nothing connects
    # from inside this container.
    set_real_ip_from ${PAGETURN_TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Never serve hidden files (.env, .git, ...) even if one ends up in the folder by mistake.
    location ~ /\. {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # Source maps are not built; refuse them explicitly anyway.
    location ~ \.map$ {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # API: the backend sends its own (stricter) security headers, so none are added here.
    location /api/ {
        # Large enough for a book cover upload (3 MB). The backend still refuses anything over 64 KB on
        # every other endpoint, so this doesn't open up the rest of the API.
        client_max_body_size 3400k;
        # With a path after the address, nginx forwards its decoded + normalised URL ("/%61pi" -> "/api"),
        # so the backend always sees the same path that was matched here.
        proxy_pass http://backend:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite (never append to) X-Forwarded-For so clients can't fake their IP to dodge rate limits.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Never pass these through from the client: they would let anyone pretend to be another site/port.
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_read_timeout 30s;
    }

    # Fingerprinted build files never change: cache them for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The app shell and service worker must always be fresh, so updates reach users immediately.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
