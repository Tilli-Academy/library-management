# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is git-ignored — real secrets must NEVER be committed.
# Used by docker-compose.yml AND by the Spring Boot backend.

# --- Database ---
PAGETURN_DB_HOST=localhost
PAGETURN_DB_PORT=55437
PAGETURN_DB_NAME=pageturn
PAGETURN_DB_USER=pageturn
# Generate with:  openssl rand -hex 24
PAGETURN_DB_PASSWORD=

# --- Login tokens ---
# Secret used to sign session tokens. Random, at least 32 characters, never shared.
# Generate with:  openssl rand -hex 48
PAGETURN_JWT_SECRET=

# --- First librarian (created on startup if this email doesn't exist yet) ---
PAGETURN_ADMIN_EMAIL=
# At least 12 characters.
PAGETURN_ADMIN_PASSWORD=
# Optional display name for that account. Leave empty to use "Head Librarian" (values with spaces need care: bash and Spring read quotes differently).
PAGETURN_ADMIN_NAME=

# --- Backend server ---
# 127.0.0.1 = reachable only from this machine
PAGETURN_SERVER_ADDRESS=127.0.0.1
PAGETURN_SERVER_PORT=8097
# true = session cookie only sent over HTTPS. Only set false for plain-http testing on localhost.
PAGETURN_COOKIE_SECURE=true
# Browser origins allowed to call the API directly (comma-separated, exact origins, never *)
PAGETURN_CORS_ALLOWED_ORIGINS=http://localhost:5177

# --- Containers (docker compose --profile app) ---
PAGETURN_WEB_PORT=8098
# The exact address people open in their browser (scheme + host + port). For a real deployment,
# e.g. https://library.example.com
PAGETURN_PUBLIC_ORIGIN=http://localhost:8098
# Address of your HTTPS front proxy, if any (its X-Forwarded-For header is trusted for the client IP,
# which rate limiting uses). Default trusts nobody.
PAGETURN_TRUSTED_PROXY_CIDR=127.0.0.1/32
